# ============================================================
# Smart Rights Viewer — Mobile (PWA)
# ============================================================

# ── 🔐 Android signing (ห้าม push เด็ดขาด) ──────────────────
*.keystore
*.jks
signing-key-info.txt
key.properties

# ── Android package ที่ได้จาก PWABuilder ───────────────────
*.apk
*.aab
*Google Play package*.zip
*Google*Play*package*

# ── Environment / secrets ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Node (ถ้าใช้ npx serve หรือเครื่องมืออื่น) ─────────────
node_modules/
npm-debug.log*
yarn-error.log*
package-lock.json

# ── Cloudflare / Wrangler ──────────────────────────────────
.wrangler/
.dev.vars

# ── Editor / IDE ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs / temp / archive ──────────────────────────────────
*.log
*.tmp
*.zip